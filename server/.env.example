# Copy to .env and fill in. Never commit the real .env.
PORT=5000
NODE_ENV=development

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=voltech_website

# Front-end origins allowed to call the API (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Where uploaded CVs are saved (outside the public web root)
UPLOAD_DIR=uploads

# Secret key for the admin read endpoints (GET /api/admin/...).
# Use a long random string, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=change-me-to-a-long-random-string

# Set to 1 when running behind Nginx / a proxy so client IPs are correct
TRUST_PROXY=0

# ── CMS ─────────────────────────────────────────────
# Secret used to sign dashboard login sessions (long random string).
JWT_SECRET=change-me-to-another-long-random-string
# Session length in hours
SESSION_HOURS=8
# 1 = cookies only over HTTPS (set 1 in production)
COOKIE_SECURE=0

# Media storage: "local" saves to UPLOAD_DIR/media and serves it at /uploads/media
#                "s3" uses any S3-compatible storage (AWS S3, DigitalOcean Spaces, Cloudflare R2…)
STORAGE_DRIVER=local
# Public base URL for local files (leave empty = same domain, e.g. /uploads/media/…)
PUBLIC_UPLOAD_URL=
# S3 settings (only when STORAGE_DRIVER=s3; also run: npm install @aws-sdk/client-s3)
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
